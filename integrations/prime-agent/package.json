{
  "name": "taskfleet-prime-agent",
  "version": "0.2.2",
  "description": "Thin Prime Agent TUI and lifecycle adapter for the Taskfleet Rust core",
  "type": "module",
  "keywords": [
    "pi-package",
    "taskfleet",
    "prime-agent"
  ],
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "test": "npm run test:ts && npm run test:python",
    "test:ts": "tsx --test test/*.test.ts",
    "test:python": "python3 -m unittest discover -s test-python",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "prime-agent": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "prime-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
